{
  "version": 1,
  "workspace": "~/activity-data",
  "people": "people.json",
  "regather_previous_month_days": 7,
  "stale_after_hours": 36,
  "lock_stale_hours": 12,
  "retention": {
    "log_days": 60,
    "store_months": null
  },
  "env": {
    "TF_PLUGIN_CACHE_DIR": ".tfcache"
  },
  "token": {
    "store": "auto",
    "env_file": "~/.config/activity-overview/token.env",
    "keychain_service": "activity-gh-token",
    "probe_repo": "Azure/bicep-registry-modules"
  },
  "streams": [
    {
      "id": "avm-bicep",
      "title": "AVM Bicep",
      "kind": "repo",
      "owner": "Azure",
      "repo": "bicep-registry-modules",
      "home": {
        "orgs": ["Azure", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["weekly", "monthly"],
      "gather_flags": ["--structural-iac"],
      "enabled": true
    },
    {
      "id": "avm-tf",
      "title": "AVM Terraform",
      "kind": "manifest",
      "manifest": "avm-tf/manifest.json",
      "home": {
        "orgs": ["Azure", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["monthly"],
      "env": {
        "ACTIVITY_IAC_MAX_WORKERS": "4"
      },
      "enabled": true
    },
    {
      "id": "bicep",
      "title": "Bicep",
      "kind": "repo",
      "owner": "Azure",
      "repo": "bicep",
      "home": {
        "orgs": ["Azure", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["weekly", "monthly"],
      "enabled": true
    },
    {
      "id": "deployment-stacks",
      "title": "Deployment stacks",
      "kind": "repo",
      "owner": "Azure",
      "repo": "deployment-stacks",
      "home": {
        "orgs": ["Azure", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["monthly"],
      "enabled": true
    },
    {
      "id": "enterprise-lz",
      "title": "Enterprise Landing Zones",
      "kind": "manifest",
      "manifest": "enterprise-lz/manifest.json",
      "home": {
        "orgs": ["Azure", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["monthly"],
      "enabled": true
    },
    {
      "id": "ai-lz",
      "title": "AI Landing Zones",
      "kind": "manifest",
      "manifest": "ai-lz/manifest.json",
      "home": {
        "orgs": ["Azure", "Azure-Samples", "microsoft"],
        "names": ["Microsoft"],
        "email_domains": ["microsoft.com"]
      },
      "cadence": ["monthly"],
      "enabled": true
    }
  ]
}
